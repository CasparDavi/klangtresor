# KlangTresor mit NVIDIA-GPU: Whisper (whisper.cpp) und Klangraum (ONNX/CUDA).
# Default bleibt Dockerfile (CPU, Mac/Windows/Linux ohne NVIDIA).
# Dieses Abbild: CUDA 12.4 + cuDNN 9, passend zu onnxruntime-node 1.20.
#
# Bauen und starten:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.cuda.yml up -d --build
#   (aus dem Projektordner; die COPY-Pfade sind von dort aus gerechnet)

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS whisper-build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 https://github.com/ggml-org/whisper.cpp.git
WORKDIR /src/whisper.cpp
# libcuda.so.1 kommt vom Treiber; beim Image-Build gibt es nur den CUDA-Stub.
# ARG: 89 = Ada (RTX 40), 86 = Ampere (RTX 30), 75 = Turing. Mehrere mit Semikolon.
# "native" geht hier nicht — der Build sieht oft keine GPU.
ARG CUDA_ARCHITECTURES=89
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/lib/x86_64-linux-gnu/libcuda.so \
 && ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/lib/x86_64-linux-gnu/libcuda.so.1 \
 && cmake -B build -DCMAKE_BUILD_TYPE=Release -DGGML_CUDA=1 \
      -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} -DBUILD_SHARED_LIBS=OFF \
      -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -Wl,-rpath-link,/usr/local/cuda/lib64/stubs" \
 && cmake --build build -j"$(nproc)" --config Release --target whisper-cli

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive \
    NODE_VERSION=20.19.4 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg libgomp1 ca-certificates curl xz-utils \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
 && groupadd --gid 1000 node \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash node \
 && rm -rf /var/lib/apt/lists/* \
 && node -v && npm -v

COPY --from=whisper-build /src/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli
RUN chmod 755 /usr/local/bin/whisper-cli

WORKDIR /app

COPY package.json package-lock.json ./
# ZWEI DINGE STIMMEN HIER NICHT, UND EINES KOENNEN WIR NICHT BEHEBEN (18.11.2026).
#
# Erstens: oben steht CUDA 12.4, das Installationsskript von onnxruntime-node 1.20.1
# fragt aber nie, welche CUDA-Fassung da ist - tryGetCudaVersion() ist ein Rumpf mit
# `return 11`. Ohne Schalter holt dieses Abbild also die CUDA-11-Bibliotheken in ein
# CUDA-12.4-Abbild. Darum steht hier jetzt ausdruecklich =12.
#
# Zweitens, und das ist die Wand: das Verzeichnis github.com/microsoft/onnxruntime
# gibt 404 - nicht nur die eine Datei, das ganze Verzeichnis, gemessen ueber zwei
# verschiedene Leitungen, waehrend andere Microsoft-Verzeichnisse normal antworten.
# Solange dort nichts liegt, ist dieses Abbild NICHT baubar, und zwar unabhaengig
# davon, was hier steht. `skip` waere keine Loesung: dann fehlt dem CUDA-Abbild
# genau das, wofuer es da ist, und es waere ein CPU-Abbild unter falschem Namen.
#
# Darum: versuchen, und beim Fehlschlag mit dem Grund abbrechen statt mit einer
# nackten 404 aus npm heraus. Kommen die Dateien zurueck, baut es von selbst wieder.
RUN ONNXRUNTIME_NODE_INSTALL_CUDA=12 npm ci --omit=dev \
 || { echo ""; \
      echo "KlangTresor: Das CUDA-Abbild laesst sich derzeit nicht bauen."; \
      echo "Grund: onnxruntime-node 1.20.1 holt seine CUDA-Bibliotheken von"; \
      echo "       github.com/microsoft/onnxruntime - dieses Verzeichnis antwortet"; \
      echo "       seit dem 18.11.2026 mit 404 (nicht nur die Datei, das Verzeichnis)."; \
      echo "Ausweg: das CPU-Abbild nehmen - docker/Dockerfile, ohne das CUDA-Overlay:"; \
      echo "       docker compose -f docker/docker-compose.yml up -d --build"; \
      echo "       Whisper und Klanganalyse laufen dort auf der CPU, alles andere gleich."; \
      echo ""; exit 1; }

COPY bin ./bin
COPY browser ./browser
COPY server ./server
COPY web ./web
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# chmod 755, nicht chmod +x: siehe Dockerfile (exFAT / ._ Dateien).
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh bin/server-start.sh \
 && chown -R node:node /app \
 && mkdir -p /app/library /app/modelle \
 && chown node:node /app/library /app/modelle

USER node

EXPOSE 8788

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["sh", "bin/server-start.sh"]
